{
  "expo": {
    "name": "chirp",
    "slug": "chirp",
    "version": "1.0.0",
    "scheme": "chirp",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.chirp.app",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:chirp.example.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.chirp.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "chirp.example.com",
              "pathPrefix": "/join-chapter"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-notifications",
      "expo-font",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "",
          "enableGooglePay": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Chirp needs access to your photos so you can attach one to a post."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a0a48d48-9308-4bb2-944a-496960739cff"
      }
    }
  }
}
