      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_WS_URL": "wss://chirp-ws-593616178468.us-central1.run.app/ws"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_WS_URL": "wss://chirp-ws-593616178468.us-central1.run.app/ws"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
