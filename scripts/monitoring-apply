#!/usr/bin/env bash
# c392: resolve an interpreter that can complete TLS before running; see
# scripts/lib/pick-python.sh and DEPLOY-VERIFICATION.md.
#
# Dry-run by default; --apply --channel ... makes live write calls. See
# MONITORING-RUNBOOK.md's "Applying the policies" section.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
source "$here/lib/pick-python.sh"
python=$(chirp_pick_python monitoring-apply) || exit $?
exec "$python" "$here/monitoring_apply.py" "$@"
