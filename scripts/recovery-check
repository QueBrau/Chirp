#!/usr/bin/env bash
# c392: recovery-check used to work by accident (a bare `#!/usr/bin/env python3`
# shebang, no network call of its own, only `gcloud` subprocesses). It must not
# become the next false NOT_READY the day a future check adds an https probe,
# so it now resolves and validates its interpreter the same way every other
# scripts/ entry point does; see scripts/lib/pick-python.sh and
# DEPLOY-VERIFICATION.md.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
source "$here/lib/pick-python.sh"
python=$(chirp_pick_python recovery-check) || exit $?
exec "$python" "$here/recovery_check.py" "$@"
