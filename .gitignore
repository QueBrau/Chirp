# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv
venv/
venv
# NOTE: no trailing slash on .venv or venv. With ".venv/" git matches a DIRECTORY
# only, which is how a SYMLINK named .venv slipped past and got committed on
# Aug 16 - it pointed at its own absolute path, so every checkout recreated a
# self-referencing link and destroyed the environment.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Env / secrets
.env
.env.*
!.env.example
INFRA-PRIVATE.*

# Node / Expo
node_modules/
node_modules
# NOTE: no trailing slash on the second one, same trap as .venv/venv above. A
# git worktree gets node_modules as a SYMLINK to the main checkout's copy, and
# "node_modules/" matches a DIRECTORY only - so `git add -A` in a worktree stages
# the link itself. Committing it would point every checkout at one machine's
# absolute path.
.expo/
.expo-shared/
expo-env.d.ts
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Native projects are GENERATED, not committed (Expo CNG — `expo prebuild`
# recreates ios/ and android/ from app.json + config plugins). These previously
# only ignored the build OUTPUT inside them, so anyone running prebuild locally
# got a few thousand untracked files staring at them.
app-mobile/ios/
app-mobile/android/

# OS
.DS_Store
.gstack/

# Agent worktrees are local scratch, never committed
.claude/worktrees/
